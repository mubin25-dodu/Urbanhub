@model ParkingDetailsModel
@{
	ViewBag.Title = "Details";
	Layout = "_LayoutParkIN";
	var Parking = Model.ParkingBooking?.Parking;
}


<partial name="alart" />
<div class="container py-5">
	<!-- Main Content Grid - Image Left, Details Right -->
	<div class="row g-4 mb-5">
		<!-- Left Column - Image -->
		<div class="col-lg-6">
			<div class="position-relative rounded-4 overflow-hidden shadow" style="aspect-ratio: 1/1;">
				<img src='@(string.IsNullOrEmpty(Parking?.Image) ? "/assets/img/Broken.png" : Parking.Image)'
					 alt="Parking spot image" class="w-100 h-100" style="object-fit: cover;">
				<!-- SECURE Badge -->
				<span class="position-absolute top-0 start-0 m-3 badge bg-primary rounded-2">
					<i class="fa-solid fa-lock"></i> SECURE
				</span>
				<!-- Rating Badge -->
				<span class="position-absolute top-0 end-0 m-3 badge bg-white text-primary fs-6">
					<i class="fa-solid fa-star"></i>
				</span>
			</div>
		</div>


		<!-- Right Column - Details -->
		<div class="col-lg-6">
			<div class="card border-0 shadow-sm rounded-4 h-100">
				<div class="card-body p-4 p-lg-5">
					<!-- Title & Address -->
					<h1 class="fs-2 fw-bold mb-2 text-primary">@(Parking?.Address)</h1>
					<p class="fs-2 fw-bold mb-2 text-secondary"> <span id="RentperHour">@(Parking?.RentPerHour)
					</span>BDT</p>

					<!-- Description -->
					<div class="mb-4">
						<h5 class="fw-bold mb-2 text-primary">About this parking</h5>
						<p class="text-secondary">@Parking?.Description</p>
					</div>

					<div class="bg-light  border-5 border-primary p-3 rounded-3 mb-4 d-flex flex-column">
						<div class="d-flex align-items-center gap-2 mb-3">
							<i class="fa-solid fa-scroll"></i>
							<h6 class="fw-bold mb-0 text-primary">Billing Summary</h6>
						</div>

						<div>
							<table class="">
								<tr >
									<th scope="row"></th>
									<td class="col-6">Rent Per Hour</td>
									<td class="col-6  text-lg-end">@Parking?.RentPerHour BDT</td>
								</tr>
								<tr class="table-active">
									<th scope="row"></th>
									<td class="col-6">Booking Duration</td>
									<td class="col-6  text-lg-end">@((Model.ParkingBooking?.EndingTime -
									                                  Model.ParkingBooking?.StartingTime)?.TotalHours
									                               ?? 0) hours</td>
								</tr>
									
								<tr class="table-active">
									<th scope="row"></th>
									<td class="col-6 ">Parking Cost</td>
									<td class="col-6  text-lg-end">@(Model.ParkingBooking?.PaymentAmount ?? 0) BDT</td>
								</tr>
								<tr class="table-active">
									<th scope="row"></th>
									<td class="col-6  ">Platform Fee</td>
									<td class="col-6  text-lg-end">@(Model.Platformfee) BDT</td>
								</tr>
								<tr class="table-active">
									<th scope="row"></th>
									<td colspan="3"><i class="fa-duotone fa-light fa-ellipsis"></i></td>
								</tr>
								<tr class="table-active">
									<th scope="row"></th>
									<td class="col-6">Total Bill</td>
									<td class="col-6  text-lg-end">@(Model.TotalBill)BDT</td>
								</tr>
								<tr>
							</table>
							<div class="col-12 d-flex accept-policy flex-column gap-2">
								// will use api for bkash payment letter (maybe)
								<label for="bkashNumber" class="form-label">Bkash Number</label>
								<input type="tel" class="form-control" id="bkashNumber" placeholder="Enter Your Bkash Number(11 Digits)"/>
								<label for="pin" class="form-label">Pin</label>
								<input type="number" class="form-control" id="pin" placeholder="Enter 6 digit Pin"/>
								<a asp-action="ProcessPayment" asp-controller="ParkINPayment" asp-route-id="@Model.ParkingBooking?.ID" class="btn btn-primary btn-lg rounded-3 fw-bold " id="payAndBookBtn">
									<i class="fa-solid fa-calendar-check me-2"></i>Pay & Book Now
								</a>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
		
			</div>

