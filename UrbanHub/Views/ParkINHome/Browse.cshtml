@{
    ViewBag.Title = "ParkIN";
    Layout = "_Layout";
    ViewData["FullWidth"] = true;
}

<section class="d-flex align-items-center" style="width: 100%; min-height: calc(100vh - 88px);
margin-top: -70px; background-image: url('/assets/img/UrbanHubHero.png');
background-size: cover; background-position: center; background-repeat: no-repeat;">
    
    <div style="margin-left:5%; max-width: 40rem; color: black; padding: 4rem 1.5rem; margin-top: -105px;">
        <h2 style="font-size: clamp(3rem, 6vw, 6.25rem); line-height: 0.95; color:black;">
            Park smart.
            <br />Live <span class="text-primary">easy.</span>
        </h2>

        <p style="font-size: clamp(1.1rem, 2vw, 1.5rem); max-width: 32rem;">
            Find, book, and manage parking spots effortlessly across the city.
        </p>

        <div class="d-flex gap-4 ">
            <button class=" btn btn-light rounded-4 px-4 py-2 mt-3" style="font-size: 1.1rem;">
            <i class="fa-solid fa-compass"></i> &nbsp; Explore ParkIN
        </button>
            <button class="btn btn-light rounded-4 px-4 py-2 mt-3" style="font-size: 1.1rem;">
                <i class="fa-solid fa-location-dot"></i> &nbsp;  Share Your Space
            </button>
            <br />
        </div>
    </div>
</section>

<section class="container py-4 px-3 px-lg-4 bg-white rounded-4 shadow-sm border position-relative" style="margin-top: -6.5rem;">
    <div class="row g-3 align-items-end">
        <div class="col-12 col-lg-3">
            <label class="form-label fw-semibold text-secondary">Enter your location</label>
            <input type="text" class="form-control form-control-lg" placeholder="City, Address, Area"/>
        </div>

        <div class="col-12 col-lg-3">
            <label class="form-label fw-semibold text-secondary">Select Vehicle Type</label>
            <select class="form-select form-select-lg">
                <option>Car</option>
                <option>Motorcycle</option>
                <option>Bicycle</option>
            </select>
        </div>

        <div class="col-12 col-lg-3">
            <label class="form-label fw-semibold text-secondary">Select Time Slot</label>
            <input type="datetime-local" class="form-control form-control-lg"/>
        </div>

        <div class="col-12 col-lg-3 d-flex align-items-end">
            <button class="btn btn-primary rounded-pill px-4 py-3 fw-semibold w-100 shadow-sm">
                Search
            </button>
        </div>
        <div class="col-12 mt-2">
            <div class="alert alert-primary d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3 rounded-4 mb-0">
                <div>
                    <div class="fw-bold mb-1">Nearby parking</div>
                    <div>See the best nearby spaces first, with a cleaner discovery flow for this new feature.</div>
                </div>
                <a asp-action="LiveMap" asp-controller="ParkINHome" class="btn btn-light text-primary fw-semibold rounded-pill px-4 py-3">
                    <i class="fa-solid fa-location-dot"></i> &nbsp; Explore nearby parking spots
                </a>
            </div>
        </div>
    </div>
</section>

<section class="container py-4 px-3 px-lg-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <p class="fw-bold fs-5 mb-0">
            <i class="fa-solid fa-magnifying-glass-location text-primary"></i>
            Available parking spaces <span class="text-success">1</span>
        </p>
        <span class="">Search Nearby</span>
    </div>
    
    <div class="row row-cols-1 row-cols-md-3 g-4">
        
        @for (int i = 0; i < 30; i++)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden">
                    <img class="card-img-top" src="/assets/img/logo.png" alt="Parking spot image" style="aspect-ratio: 16 / 10; object-fit: cover;">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <h5 class="card-title mb-1 fw-semibold">Nearby spot</h5>
                                <p class="text-muted small mb-0">2 min walk from your location</p>
                            </div>
                            <span class="badge text-bg-success rounded-pill">Open</span>
                        </div>
                        <p class="card-text text-secondary">A clean, easy-to-book space with the closest match highlighted first.</p>
                        <a href="#" class="btn btn-outline-primary rounded-pill px-3">View details</a>
                    </div>
                </div>
            </div>
        }

    </div>
    </section>
