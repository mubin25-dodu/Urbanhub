@model List<ParkingSpace>
@{
	ViewBag.Title = "My Bookings";
	Layout = "_LayoutParkIN";
}

<partial name="alart" />

<div class="container-fluid py-4 py-lg-5">
	<div class="row mb-5">
		<div class="col-12">
			<h1 class="fw-bold text-dark mb-1">My Parking Bookings</h1>
			<p class="text-muted mb-0">View and manage all your parking reservations</p>
		</div>
	</div>

	@if (Model != null && Model.Count > 0)
	{
		<div class="card border-0 shadow-sm">
			<div class="card-body p-0">
				<div class="table-responsive">


					<table class="table table-hover mb-0">
						<thead class="table-light">
							<tr>
								<th class="text-center">Address</th>
								<th class="text-center">Rent/Hour</th>
								<th class="text-center">Available</th>
								<th class="text-center">Vehicle Type</th>
								<th class="text-center">Description</th>
								<th class="text-center">Actions</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var booking in Model)
							{
								<tr class="align-middle">
									<td class="fw-500 text-info">@booking.Address</td>
									<td class="text-center">৳@booking.RentPerHour</td>
									<td class="text-center">
										@if (booking.IsAvailable)
										{
											<span class="badge bg-success">Available</span>
										}
										else
										{
											<span class="badge bg-warning">Not Available</span>
										}
									</td>
									<td class="text-center">
										<span class="badge bg-info">@booking.VehicleType</span>
									</td>
									<td class="text-center">@booking.Description</td>
									<td class="text-center">
										<a>Edit</a>
										<a>Delete</a>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		</div>
	}
	else
	{
		<div class="alert alert-info text-center py-5" role="alert">
			<i class="fas fa-inbox fa-3x mb-3 d-block"></i>
			<h5 class="mb-2">No Bookings Yet</h5>
			<p class="mb-0">You haven't made any parking bookings. Start exploring available parking spaces now!</p>
		</div>
	}
</div>
